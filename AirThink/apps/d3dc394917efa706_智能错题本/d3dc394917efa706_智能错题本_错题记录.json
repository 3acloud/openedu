{
  "表名": "错题记录",
  "字段": [
    {
      "字段名": "题目",
      "类型": "文本"
    },
    {
      "字段名": "错题文件",
      "类型": "文本"
    },
    {
      "字段名": "科目",
      "类型": "单选项",
      "可选项": [
        "数学",
        "物理",
        "化学",
        "历史",
        "生物",
        "地理",
        "语文",
        "英语",
        "其他"
      ]
    },
    {
      "字段名": "题目来源",
      "类型": "单选项",
      "可选项": [
        "作业",
        "测验",
        "自练"
      ]
    },
    {
      "字段名": "做错时的状态",
      "类型": "单选项",
      "可选项": [
        "怀疑自己错了",
        "以为做对了"
      ]
    },
    {
      "字段名": "已看正确答案",
      "类型": "布尔"
    },
    {
      "字段名": "我的答案与思路",
      "类型": "文本"
    },
    {
      "字段名": "正确答案",
      "类型": "文本"
    },
    {
      "字段名": "错因分析",
      "类型": "指令流",
      "指令类型": "任务智能体",
      "指令描述": "使用技能 xiaozhi-correction-notebook 分析这道错题。科目：{{科目}}；题目：{{题目}}；来源：{{题目来源}}；做错时的状态：{{做错时的状态}}；已看正确答案：{{已看正确答案}}；我的答案与思路：{{我的答案与思路}}；正确答案：{{正确答案}}。先核对题目与学生思路；信息不足时提出必要问题，不臆测根因。信息充分时给出通用四维中的一个主要错因、一句话根因、逐级提示及一道经自检的同类题；在学生尝试前不要直接给原题答案。",
      "文件字段": "错题文件",
      "输出类型": "文本"
    }
  ]
}