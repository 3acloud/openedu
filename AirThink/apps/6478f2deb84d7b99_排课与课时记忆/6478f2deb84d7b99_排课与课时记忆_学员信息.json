{
  "表名": "学员信息",
  "字段": [
    {
      "字段名": "学员化名",
      "类型": "文本"
    },
    {
      "字段名": "学段",
      "类型": "单选项",
      "可选项": [
        "小学中段",
        "小学高段",
        "初中",
        "高中"
      ]
    },
    {
      "字段名": "可上课时间段",
      "类型": "文本"
    },
    {
      "字段名": "记录状态",
      "类型": "单选项",
      "可选项": [
        "在读",
        "暂停记录",
        "已结课"
      ]
    },
    {
      "字段名": "课时包总课时",
      "类型": "数值"
    },
    {
      "字段名": "剩余课时",
      "类型": "数值"
    },
    {
      "字段名": "待确认课时",
      "类型": "数值"
    },
    {
      "字段名": "课时包到期日",
      "类型": "日期"
    }
  ]
}