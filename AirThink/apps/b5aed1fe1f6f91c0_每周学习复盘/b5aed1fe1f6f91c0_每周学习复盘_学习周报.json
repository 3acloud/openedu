{
  "表名": "学习周报",
  "字段": [
    {
      "字段名": "周开始日期",
      "类型": "日期"
    },
    {
      "字段名": "周结束日期",
      "类型": "日期"
    },
    {
      "字段名": "学生昵称",
      "类型": "文本"
    },
    {
      "字段名": "学段",
      "类型": "单选项",
      "可选项": [
        "小学中段",
        "小学高段",
        "初中",
        "高中"
      ]
    },
    {
      "字段名": "学习记录文件",
      "类型": "文本"
    },
    {
      "字段名": "自我复盘",
      "类型": "文本"
    },
    {
      "字段名": "家庭分享授权",
      "类型": "布尔"
    },
    {
      "字段名": "情绪分享授权",
      "类型": "布尔"
    },
    {
      "字段名": "周报内容",
      "类型": "指令流",
      "指令类型": "任务智能体",
      "指令描述": "使用技能 xiaozhi-weekly-review，为{{学生昵称}}生成{{周开始日期}}至{{周结束日期}}的学习复盘。学段为{{学段}}，学生自评为{{自我复盘}}。只依据提供的记录写出有证据的结论；数据不足时明确说明，不编造统计。小学中高段采用三问版，初高中采用六模块周报；下周只给一个重点及至多三条行动。仅当{{家庭分享授权}}为真时附家庭分享版，且仅当{{情绪分享授权}}也为真时包含情绪内容。遇到危机信号按技能中的危机例外处理。输出单份 Markdown 文本。",
      "文件字段": "学习记录文件",
      "输出类型": "文本"
    }
  ]
}